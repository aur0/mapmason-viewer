    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "typescript": "5.7.3",
    "vite": "6.4.4",
